!.gitignore
!README.md
!docker-compose.yml
!requirements.txt

# ✅ PRIMEIRO ignore tudo
*

# ✅ DEPOIS permita apenas as pastas importantes
!app/
!app/**/*

!spark/
!spark/src/
!spark/src/**/*

!database/
!database/**/*


!shared/
!shared/**/*

# ✅ AGORA sim, ignore os arquivos temporários
**/__pycache__/
*.pyc
**/*.pyo
**/*.pyd
**.pyc

# Resto do gitignore...
**/.vscode/
**/.idea/
**/*.swp
**/*.swo
**/*.save
**/*.tmp
**/*.log
**/logs/
**/database/data/
**/data/raw/
**/data/processed/
**/data/output/
**/data/temp/