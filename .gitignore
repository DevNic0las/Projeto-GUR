# IGNORAR TUDO por padrão
*

# ✅ PERMITIR arquivos raiz importantes
!README.md
!docker-compose.yml
!.gitignore

# ✅ PERMITIR pasta app (Flask - frontend/API)
!app/
app/*
!app/app.py
!app/requirements.txt
!app/Dockerfile
!app/templates/
!app/templates/**
!app/static/
!app/static/**
!app/routes.py


# ✅ PERMITIR pasta spark (Spark - backend/processamento)
!spark/
!spark/src/
!spark/src/utils/
!spark/src/utils/**
!spark/src/etl/
!spark/src/etl/**
!spark/src/main.py
!spark/requirements.txt
!spark/Dockerfile
!spark/src/pipelines/
spark/data/
spark/src/data/*
# ✅ PERMITIR shared (dados compartilhados)
!shared/
!shared/**

# ❌ IGNORAR sempre
**/__pycache__/
**/.env
**/*.log
**/.DS_Store
**/.vscode/