# ✅ Permitir arquivos essenciais na raiz
!.gitignore
!README.md
!docker-compose.yml
!requirements.txt

# ✅ PRIMEIRO: ignore tudo
*

# ✅ DEPOIS: permita apenas as pastas de código-fonte
!app/
!app/**/*
!spark/
!spark/src/
!spark/src/**/*
!database/
!database/**/*
!shared/
!shared/**/*

# ✅ AGORA: ignore tudo o que for cache, compilado ou temporário, mesmo dentro das pastas permitidas

# Ignorar todos os caches de Python em qualquer nível
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc
*.pyo
**/*.pyo
*.pyd
**/*.pyd

# Ignorar diretórios de dados locais, logs e temporários
**/.vscode/
**/.idea/
**/*.swp
**/*.swo
**/*.save
**/*.tmp
**/*.log
**/logs/
**/log/
**/tmp/
**/temp/

# Ignorar dados de bancos locais (MongoDB, etc.)
**/database/data/
**/data/raw/
**/data/processed/
**/data/output/
**/data/temp/

# Ignorar dados gerados por Spark
spark/src/data/parquet/
*.parquet
*.crc
_SUCCESS
